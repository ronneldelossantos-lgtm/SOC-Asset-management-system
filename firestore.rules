rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app has no Firebase Authentication — it does its own
    // username/password check inside the client. Access is scoped to just
    // the one collection the app uses, not opened database-wide.
    match /sms_erp_storage/{docId} {
      allow read, write: if true;
    }
    // Requests, returns, and issuance are one document per record. The app
    // still has its legacy client-side access model, so these match the
    // existing collection's temporary unauthenticated policy.
    match /requests/{recordId} {
      allow read, write: if true;
    }
    match /returns/{recordId} {
      allow read, write: if true;
    }
    match /issuance/{recordId} {
      allow read, write: if true;
    }
    // Isolated pilot-v2 collections. The previous collections are retained
    // read/write for the legacy deployment but are not used by the new app.
    match /pilot_v2_requests/{recordId} {
      allow read, write: if true;
    }
    match /pilot_v2_returns/{recordId} {
      allow read, write: if true;
    }
    match /pilot_v2_issuance/{recordId} {
      allow read, write: if true;
    }
  }
}
